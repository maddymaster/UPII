# Virtual environments
venv/
.venv/
env/

# Build artifacts
build/
dist/
release/
*.spec
# …but the committed PyInstaller spec is the reproducible-build source (Phase 8 / release.yml)
!upii.spec
*.egg-info/
# stray sdist extraction dirs from local builds
upii-*/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Databases & vector stores
*.db
upii_vectors/

# Logs
*.log

# OS
.DS_Store

# Local config (may contain API keys)
.upii_config.yaml

# Runtime state (written by `upii watch`; not source)
features.yaml
sources.yaml

# Demo scratch dirs (the scripts clean these up; ignore if one crashes mid-run)
.repro_demo/
.phase1_demo/
.phase3_demo/
.phase4_demo/

# Generated knowledge-graph render (phase4_demo.sh / `upii knowledge --graph`)
graph.html

# Phase 3 eval: isolated index rebuilt from the committed corpus (labels.json is committed)
eval/.index/

# ---------------------------------------------------------------------------
# Internal working material — kept local, not part of the public package.
# The technical docs (design_blueprint, data_model, packaging, qa_plan, audits,
# REPORTs) and the test fixtures are tracked and stay.
# NOTE: files already committed stay tracked until `git rm --cached <path>`.
# ---------------------------------------------------------------------------

# Funding / programme paperwork
ELEVATE_Nxt_Grant/

# Superseded internal duplicates of docs/, plus release-manager notes
project_docs/

# Business strategy, GTM, product-requirements
STRATEGY_grant_and_gtm.md
UPII_PRD.md

# Status walkthroughs (point-in-time snapshots, superseded by the jury walkthrough)
docs/walkthrough*.md

# Milestone scorecard (the technical audit it summarises is kept:
# docs/phase2_reproducibility_audit.md)
docs/phase2_deliverables.md

# Demo data derived from real partner/meeting notes
demo_data_v2/

# Seeds the demo store from demo_data_v2/ above; bypasses the deterministic ingest
# pipeline (random uuids), so it is internal scratch tooling, not a public entry point.
scripts/reset_demo_env.py

# Website (maintained separately, not part of the open-source package)
website/

# Paper drafts (keep private until published; move to internal repo or un-ignore at submission)
paper/

# Debug / scratch files
debug_*.py
verification_output.txt
